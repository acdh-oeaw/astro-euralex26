---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

import { getImageFormat, getLocalImageImport } from "@/lib/get-image-import";

interface Props extends HTMLAttributes<"img"> {}

const { title = "", alt = "", src, width, height, sizes, ...rest } = Astro.props;
const optimized = src?.startsWith("/") ? (await getLocalImageImport(src)).default : undefined;
const format = getImageFormat(src);
---

{src != null ? (
	optimized ? (
		<Image
			{...rest}
			title={title}
			alt={alt}
			src={optimized}
			width={Math.min(optimized.width, 1600)}
			widths={[400, 800, 1024, 1600]}
			sizes={sizes ?? "min(calc(100vw - 2rem), 62rem)"}
			format={format}
			quality={82}
		/>
	) : (
		<img {...rest} title={title} alt={alt} height={height} sizes={sizes} src={src} width={width} />
	)
) : null}
