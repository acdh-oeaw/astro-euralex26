---
import { createVideoEmbedUrl, type VideoSource } from "@/lib/content/create-video-embed-url";

interface Props {
	source: VideoSource;
	title?: string;
}

const { source, title } = Astro.props;

const href = String(createVideoEmbedUrl(source));
---

<figure>
	<iframe
		allowfullscreen
		class="aspect-video w-full overflow-hidden rounded-md"
		src={href}
		title={title ?? "Video"}></iframe>
	{
		Astro.slots.has("default") ? (
			<figcaption>
				<slot />
			</figcaption>
		) : null
	}
</figure>
