---
import Img from "@/components/content/img.astro";

interface Props {
	alt: string;
	license: string;
	src: string;
	title: string;
}

const { alt, license, src, title } = Astro.props;
---

<figure data-image-slide>
	<div data-image-frame>
		<Img alt={alt} src={src} />
	</div>
	<figcaption class="grid gap-1">
		<strong>{title}</strong>
		<span>{license}</span>
	</figcaption>
</figure>

<style>
	[data-image-frame] {
		aspect-ratio: 3 / 2;
		background: rgb(243 243 243);
	}

	[data-image-frame] :global(img) {
		object-fit: contain;
		width: 100%;
		height: 100%;
	}
</style>
