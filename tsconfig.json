{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": ["astro/tsconfigs/base", "@acdh-oeaw/tsconfig"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"],
			"~/*": ["./*"]
		},
		"plugins": [{ "name": "@astrojs/ts-plugin" }],
		"types": ["astro/client", "node"]
	},
	"include": [".astro/types.d.ts", "./**/*"],
	"exclude": ["dist", "node_modules"]
}
