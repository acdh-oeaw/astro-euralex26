{
	"name": "@acdh-oeaw/euralex26",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"build": "run-s build:site generate:search-index",
		"build:site": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:search-index": "pagefind --site ./dist/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:styles:check": "stylelint \"./src/**/*.@(astro|css)\" --cache",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"prepare": "run-s setup",
		"setup": "is-ci || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "exit 0",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "astro check",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "3.7.6",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/red-hat-display": "5.3.0",
		"@iconify-json/lucide": "^1.2.117",
		"@iconify-json/simple-icons": "^1.2.90",
		"@keystatic/core": "^0.6.10",
		"@mdx-js/mdx": "^3.1.1",
		"@pagefind/default-ui": "^1.5.2",
		"@sindresorhus/slugify": "^4.0.1",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"cva": "1.0.0-beta.12",
		"date-fns": "^4.4.0",
		"estree-util-value-to-estree": "^3.5.0",
		"hast-util-heading": "^3.0.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.1",
		"lucide-react": "^1.80.0",
		"mdast-util-mdx-jsx": "^3.2.0",
		"pagefind": "^1.5.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"remark-smartypants": "^3.0.2",
		"retext-smartypants": "^6.2.0",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"valibot": "^1.5.0",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/ts-plugin": "^1.11.0",
		"@keystatic/astro": "^6.0.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/estree": "^1.0.9",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.12.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.4.0",
		"is-ci": "^4.1.0",
		"lefthook": "^2.2.3",
		"npm-run-all2": "^9.1.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.3",
		"typescript": "^6.0.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			],
			"declaration-property-value-no-unknown": [
				true,
				{
					"ignoreProperties": {
						"/.+/": [
							"/theme\\(.+\\)/"
						]
					}
				}
			]
		}
	}
}
